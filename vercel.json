{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://worksetu-api.onrender.com/api/v1/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://worksetu-api.onrender.com/socket.io/:path*" },
    { "source": "/((?!api.js|app.js|index.html|mockData.js|translations.js|.*\\..+).*)", "destination": "/index.html" }
  ]
}
