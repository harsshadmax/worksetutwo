# Worksetu backend — copy to .env and fill in real values. Never commit .env.

# Postgres (Supabase), pooled connection (PgBouncer/Supavisor, transaction
# mode) — used by the app at runtime. Get this from Supabase's dashboard:
# Connect button (top of project page) -> select "Prisma" as the framework
# -> copy the DATABASE_URL line verbatim. The username MUST be
# "postgres.<project-ref>" (not just "postgres") when going through the
# pooler — the pooler is shared infra and uses the suffix to route to your
# project.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Postgres (Supabase), used only by `prisma migrate`. Use the SESSION
# POOLER here (same pooler hostname as above, port 5432) rather than
# Supabase's raw "db.<project-ref>.supabase.co:5432" host — that raw host
# resolves IPv6-only, which fails outright ("Can't reach database server")
# on IPv4-only hosting platforms (Render, and others), even though it
# works fine from a machine with IPv6 connectivity (most home/dev
# networks). Confirmed live while deploying this project to Render.
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# HS256 signing secret for access tokens — high-entropy, never reused across environments
JWT_SECRET=replace-with-a-long-random-value

# Redis — dispatch locks, rate limiting, caching (Section 3.3, 4.10, 24.3)
REDIS_URL=redis://localhost:6379

# HTTP port the Express server listens on
PORT=4000

# development | production — gates verbose error detail (Section 8.5)
NODE_ENV=development

# Comma-separated explicit origin allowlist for CORS (Section 8.2) — never *.
# For the deployed frontend, add its exact Vercel URL, e.g.:
# CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Notification channel stubs (Section 18) — interface-ready, not wired to a real provider in this pass
EMAIL_PROVIDER=
SMS_PROVIDER=
PUSH_PROVIDER=
